{
    "name": "capell-app/pest-plugin-blade-coverage",
    "description": "Pest plugin for ratcheted Laravel Blade view coverage checks.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Capell",
            "email": "hello@capell.app"
        }
    ],
    "require": {
        "php": "^8.4",
        "pestphp/pest-plugin": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "laravel/pint": "^1.25"
    },
    "autoload": {
        "psr-4": {
            "Capell\\PestBladeCoverage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\PestBladeCoverage\\Tests\\": "tests/"
        }
    },
    "extra": {
        "pest": {
            "plugins": [
                "Capell\\PestBladeCoverage\\BladeCoveragePlugin"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "test": "pest --colors=always",
        "test:tia": "pest --colors=always --tia"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
